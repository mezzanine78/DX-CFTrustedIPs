# Copy to .env (chmod 600). Never commit .env.
# --- Cloudflare (required) ---
CF_API_TOKEN=                 # scoped token: Account > Zero Trust > Edit (zerotrust) or Account > Account Filter Lists > Edit (rules)
CF_ACCOUNT_ID=                # 32-char account ID (dashboard > Account home > Account ID)
CF_LIST_ID=                   # Zero Trust list UUID (or 32-char rules list ID when CF_LIST_KIND=rules)
CF_LIST_KIND=zerotrust        # zerotrust = list usable by Access 'IP list' selector; rules = WAF custom list
# --- ntfy alerts ---
NTFY_URL=https://ntfy.ausict.com/bct-ryan-bl-4456629bd50c
NTFY_TOKEN=
# --- Static allowlist, always kept (Label=IP or CIDR; separate with ';') ---
STATIC_ALLOWLIST=BCT-Office=203.0.113.10
# --- Report endpoint ---
TRUSTED_PROXIES=10.23.23.176  # only these peers may set X-Forwarded-For (NPM)
IP_SOURCE=request             # request = trust the source IP NPM saw (default); client = trust the IP the collector reports
CFIP_PORT=8090                # host port published for NPM to forward to
# --- Sync and safeguards ---
SYNC_INTERVAL_SECONDS=3600
SYNC_ON_CHANGE=true           # sync within seconds when a client's IP changes
MIN_ITEMS=2                   # removals blocked if the list would drop below this many managed items
MAX_REMOVALS_PER_RUN=2        # removals blocked if a run wants to remove more than this
STALE_ALERT_HOURS=13          # alert when a client has not reported for this long (IP kept)
STALE_TTL_HOURS=168           # remove a client's IP only after this long without a report
MAX_IP_CHANGES_PER_DAY=4      # more changes than this in 24h -> new IP quarantined until 'client approve'
MANAGED_PREFIX=dx-cfip        # item descriptions starting 'dx-cfip:' are owned by this tool; others are never touched
DRY_RUN=false                 # true = log the diff only, no Cloudflare writes, no ntfy
